# CellTx Match — environment variables
# Copy this to .env.local for local dev (Vite reads VITE_* automatically)
# Set the same variables in Vercel dashboard for production.
#
# NONE of these are required for the app to run — every integration
# has a graceful fallback. Add them when you're ready to activate
# the corresponding feature.

# ─── Clerk (auth) ─────────────────────────────────────────────────────────
# Sign up at https://clerk.com, create application, paste publishable key.
# Optional: app works without auth too (Sign In button just won't appear).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Backend (only needed for Stripe Customer Portal + webhook → Clerk metadata sync):
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# ─── Stripe (billing) ─────────────────────────────────────────────────────
# Sign up at https://stripe.com. Create 4 recurring products in dashboard:
#   1. Practice Monthly       $299/mo
#   2. Practice Yearly        $2,990/yr
#   3. Institution Monthly    $999/mo
#   4. Institution Yearly     $9,990/yr
# Copy each Price ID (price_xxx) into the corresponding var below.
# Without these set, the pricing CTAs gracefully fall back to the waitlist modal.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_PRACTICE_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_PRACTICE_YEARLY=price_xxxxxxxx
STRIPE_PRICE_INSTITUTION_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_INSTITUTION_YEARLY=price_xxxxxxxx

# Stripe webhook setup:
#   Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://cart-match.vercel.app/api/stripe/webhook
#   Events: checkout.session.completed, customer.subscription.*, invoice.payment_failed
# Copy the signing secret into STRIPE_WEBHOOK_SECRET above.

# ─── Resend (transactional email) ─────────────────────────────────────────
# Sign up at https://resend.com (free tier: 100/day, 3k/month).
# Verify your sending domain (or use resend.dev for testing).
# Without RESEND_API_KEY set, waitlist submissions fall back to Formspree.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="CellTx Match <hello@cart-match.com>"
FOUNDER_EMAIL=sri.ramya003@gmail.com

# ─── Site URL ─────────────────────────────────────────────────────────────
# Used by Stripe Checkout for success/cancel redirects. Optional — defaults
# to request host. Set in production for cleaner URLs.
SITE_URL=https://cart-match.vercel.app

# ─── Plausible Analytics ──────────────────────────────────────────────────
# No env vars needed — script is hard-coded to data-domain="cart-match.vercel.app"
# in index.html. Just sign up at plausible.io and add the domain to your
# account to start receiving events.
